# Same domain as production: not a secret, and there is only one pool.
# VITE_CLIENT_ID stays empty here too, same as .env.production, until the
# pool is deployed — `npm run dev` will show the "configurazione mancante"
# guard from auth.ts instead of a blank page until it is filled in.
VITE_LOGIN_DOMAIN=https://turni-vanessa.auth.eu-south-1.amazoncognito.com
VITE_CLIENT_ID=
