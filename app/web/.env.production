# Ne' l'uno ne' l'altro e' un segreto: stanno nel bundle, e devono starci.
# Questo host e' anche l'identita' a cui la passkey resta legata: Cognito
# vuole che il relying party id sia esattamente il dominio di accesso. Sta
# sotto vanessa.matteo.cool, e non su amazoncognito.com, perche' deve essere
# un nome nostro — cambiarlo dopo obbliga a registrare di nuovo la passkey su
# ogni dispositivo.
VITE_LOGIN_DOMAIN=https://auth.vanessa.matteo.cool
VITE_CLIENT_ID=
